# ── Anthropic ──────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── Redis (optional – falls back to in-memory if not set) ──
REDIS_URL=redis://localhost:6379

# ── Server ─────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# ── Agent tuning ───────────────────────────────────────────
# Model used for all agents
AGENT_MODEL=claude-sonnet-4-20250514
# Max ReAct iterations before forcing output
MAX_REACT_ITERATIONS=3
# Minimum confidence score (0-100) to emit a recommendation
MIN_CONFIDENCE=65
# Cache TTL for tool results, in seconds (15 min)
TOOL_CACHE_TTL=900
